{
  "name": "tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tokens/src",
  "projectType": "library",
  "tags": ["type:tokens", "scope:tokens"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/packages/tokens/dist"],
      "options": {
        "main": "packages/tokens/src/index.ts",
        "outputPath": "packages/tokens/dist",
        "tsConfig": "packages/tokens/tsconfig.lib.json",
        "generatePackageJson": false,
        "assets": [
          {
            "glob": "**/*.css",
            "input": "packages/tokens/src",
            "output": "."
          }
        ]
      }
    }
  }
}

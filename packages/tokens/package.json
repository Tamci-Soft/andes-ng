{
  "name": "@andes-ng/tokens",
  "version": "0.0.1",
  "description": "Framework-agnostic design tokens for Andes NG.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@andes-ng/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "@andes-ng/source": "./src/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/theme.css"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  }
}

{
  "name": "@andes-ng/tokens",
  "version": "0.0.1",
  "description": "Framework-agnostic design tokens for Andes NG.",
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "theme",
    "dark-mode",
    "design-system"
  ],
  "homepage": "https://github.com/andes-ng/andes/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/andes-ng/andes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andes-ng/andes.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@andes-ng/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "@andes-ng/source": "./src/theme.css",
      "default": "./dist/theme.css"
    },
    "./fonts.css": {
      "@andes-ng/source": "./src/fonts.css",
      "default": "./dist/fonts.css"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/theme.css",
    "./dist/fonts.css"
  ],
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "tslib": "^2.3.0"
  }
}

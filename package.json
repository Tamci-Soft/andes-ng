    "@angular/language-service": "~22.1.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.2.0",
    "@nx/devkit": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/playwright": "23.2.0",
